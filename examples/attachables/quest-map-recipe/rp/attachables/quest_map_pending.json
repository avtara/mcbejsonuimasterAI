{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "kit_demo:quest_map_pending.player",
      "item": {
        "kit_demo:quest_map_pending": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/quest_map/pending"
      },
      "geometry": {
        "default": "geometry.kit_demo.quest_map"
      },
      "animations": {
        "main_first": "animation.kit_demo.quest_map.main_first",
        "off_first": "animation.kit_demo.quest_map.off_first",
        "main_third": "animation.kit_demo.quest_map.main_third",
        "off_third": "animation.kit_demo.quest_map.off_third"
      },
      "scripts": {
        "animate": [
          {
            "main_first": "context.is_first_person && context.item_slot == 'main_hand'"
          },
          {
            "off_first": "context.is_first_person && context.item_slot == 'off_hand'"
          },
          {
            "main_third": "!context.is_first_person && context.item_slot == 'main_hand'"
          },
          {
            "off_third": "!context.is_first_person && context.item_slot == 'off_hand'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kit_demo.quest_map"
      ]
    }
  }
}

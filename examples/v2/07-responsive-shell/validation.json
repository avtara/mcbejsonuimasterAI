{
  "schemaVersion": 1,
  "id": "responsive_shell",
  "status": "static-structure-ready",
  "runtimeStatus": "not-verified-in-bedrock",
  "redistribution": {
    "code": "MIT",
    "codeSpdx": "MIT",
    "assets": "CC0-1.0",
    "assetSpdx": "CC0-1.0",
    "origin": "first-party deterministic generator",
    "licenseEvidence": "../LICENSE.md"
  },
  "profiles": [
    "pc_1920x1080_gui3",
    "touch_1280x720_gui2"
  ],
  "design": {
    "family": "responsive_safe_shell",
    "rootSize": [
      720,
      390
    ],
    "alignmentToleranceUiUnits": 1,
    "repeatedGapPolicy": "one size and one gap per repeated group",
    "labelPolicy": "every label has explicit size"
  },
  "protocol": {
    "token": "v2:responsive",
    "sender": "BP/scripts/main.js",
    "uiEntry": "RP/ui/server_form.json"
  },
  "requiredFiles": [
    "RP/manifest.json",
    "RP/ui/_ui_defs.json",
    "RP/ui/server_form.json",
    "RP/ui/features/responsive_shell/screen.json",
    "BP/manifest.json",
    "BP/scripts/main.js",
    "ir.yaml",
    "preview/preview.png",
    "preview/measurement-overlay.png"
  ],
  "textCoverage": {
    "version": 1,
    "scope": "static-solved-labels",
    "hasBody": true,
    "policy": "Cover every authored label with a solved rectangle at its original scale. Role fixtures exercise these static examples; they do not certify arbitrary runtime values or nested button-state text.",
    "targets": [
      {
        "id": "title",
        "role": "title",
        "fixtures": [
          "source",
          "responsive_shell_title_ko"
        ]
      },
      {
        "id": "description",
        "role": "body",
        "fixtures": [
          "source",
          "long_ko_130",
          "long_en",
          "unbroken_token"
        ]
      },
      {
        "id": "content_label",
        "role": "instructions",
        "fixtures": [
          "source",
          "responsive_instructions_ko"
        ]
      }
    ]
  },
  "checks": {
    "jsonParse": "passed",
    "javascriptSyntax": "passed",
    "textureReferences": "passed",
    "ninesliceSidecars": "passed",
    "normalizedColorComponents": "passed",
    "bedrockRuntime": "not-run",
    "contentLog": "not-run"
  }
}
